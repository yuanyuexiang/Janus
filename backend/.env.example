# ----- Application -----
ENV=dev
APP_NAME=圆桌投研

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://yuanzhuo:yuanzhuo@127.0.0.1:5432/yuanzhuo
REDIS_URL=redis://127.0.0.1:6379/0

# ----- Claude Relay (M1+) -----
# 订阅版 Claude 不能直连 API，需要通过中转或申请 Anthropic API Key
RELAY_BASE_URL=
RELAY_API_KEY=

# ----- Models -----
CONDUCTOR_MODEL=claude-opus-4-7
DEFAULT_ADVISOR_MODEL=claude-sonnet-4-6
ROUTER_MODEL=claude-haiku-4-5

# ----- Data Sources -----
CHOICE_USER=
CHOICE_PASSWORD=
# Choice Gateway 服务地址；本地直跑写 http://localhost:9001，docker compose 内写 http://choice-gateway:9001
CHOICE_GATEWAY_URL=
TUSHARE_TOKEN=

# ----- CORS -----
# JSON 数组格式（pydantic-settings 自动解析）
CORS_ORIGINS=["http://localhost:3000"]
